# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN (COMESIS)
# ==============================================================================
APP_NAME=COMESIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zona horaria institucional
APP_TIMEZONE="America/Caracas"

# ==============================================================================
# REGISTRO Y LOGS (LOGGING)
# ==============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# BASE DE DATOS PRINCIPAL: COMESIS (Comedor Universitario)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=comesis
DB_USERNAME=root
DB_PASSWORD=

# ==============================================================================
# BASE DE DATOS SECUNDARIA: DUX (Sincronización Estudiantes)
# ==============================================================================
DB_HOST_SECOND=127.0.0.1
DB_PORT_SECOND=3306
DB_DATABASE_SECOND=mock_dux
DB_USERNAME_SECOND=root
DB_PASSWORD_SECOND=

# ==============================================================================
# BASE DE DATOS TERCIARIA: TEREPAIMA (Sincronización Personal / Empleados RRHH)
# ==============================================================================
DB_HOST_THIRD=127.0.0.1
DB_PORT_THIRD=3306
DB_DATABASE_THIRD=mock_empleados
DB_USERNAME_THIRD=root
DB_PASSWORD_THIRD=

# ==============================================================================
# CONTROL DE SESIONES, COLAS, CACHÉ Y ALMACENAMIENTO (DRIVERS)
# ==============================================================================
# IMPORTANTE: Se requiere SESSION_DRIVER=database para el rastreo en vivo de
# cajeros, prevención de sesiones concurrentes y auto-liberación de taquillas/ATMs.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Conexión de colas para sincronización en segundo plano (sync en local, database en servidor)
QUEUE_CONNECTION=sync

# Caché y almacenamiento
CACHE_STORE=file
CACHE_PREFIX=comesis_cache_

FILESYSTEM_DISK=local
FILESYSTEM_DRIVER=local

BROADCAST_CONNECTION=log

# ==============================================================================
# REDIS (Opcional para alto rendimiento en caché o colas)
# ==============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# CORREO ELECTRÓNICO (NOTIFICACIONES / SMTP)
# ==============================================================================
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@unellez.edu.ve"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# SERVICIOS EXTERNOS (AWS / ALMACENAMIENTO EN LA NUBE / PUSHER)
# ==============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
