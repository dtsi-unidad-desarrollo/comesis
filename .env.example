# Example environment file
# Copy this to .env and fill real values (do NOT commit .env with secrets)

APP_NAME=Comedor
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

# Super user (root) credentials
# Set a secure email and password for the root account before seeding
ROOT_NAME=Super usuario
ROOT_ROLE=1
ROOT_EMAIL=root@example.com
ROOT_PASSWORD=YourSecurePasswordHere
